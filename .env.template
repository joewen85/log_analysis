# Copy to .env and adjust as needed.
# Example:
#   cp .env.template .env

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=ai-convergence-pipeline
KAFKA_AUTO_OFFSET_RESET=latest
RAW_TOPIC=linux_raw_logs
CONVERGED_TOPIC=linux_converged_logs
KAFKA_TEST_TOPIC=linux_raw_logs

# AI
# Provider:
# - openai_compatible: 任意 OpenAI 兼容接口（默认）
# - ollama: 本地 Ollama（未显式配置 base_url 时自动回退 http://localhost:11434/v1）
AI_PROVIDER=openai_compatible
AI_ANALYSIS_ENABLED=true
AI_MODEL=llama3.1:8b
# 远程模型示例: https://your-llm-gateway/v1
# 官方 OpenAI 可留空（将使用 SDK 默认地址）
AI_BASE_URL=
AI_API_KEY=
# 可选: 某些平台需要组织/项目
AI_ORGANIZATION=
AI_PROJECT=
AI_RETRY_TIMES=2
AI_TIMEOUT_SEC=15
AI_CACHE_MAX_SIZE=1000
AI_CACHE_TTL_SEC=600
BEHAVIOR_AI_ENABLED=true
BEHAVIOR_MIN_REQUESTS=20
BEHAVIOR_TOP_PATHS=5

# Sanitizer
SANITIZE_ENABLED=true
SANITIZE_MASK_IP=true
SANITIZE_MASK_CREDENTIALS=true
# 自定义脱敏规则:
# 格式 pattern=>replacement，多个规则用 || 分隔
# 例: sessionid=[^\\s;]+=>sessionid=[MASKED]||[A-Fa-f0-9]{32}=>[HEX32]
SANITIZE_EXTRA_RULES=

# Converge window
WINDOW_MINUTES=5
MIN_COUNT_THRESHOLD=5
MAX_SAMPLE_SIZE=3

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=log_ai
CLICKHOUSE_USER=logai
CLICKHOUSE_PASSWORD=logai123456

# Alerting
ALERT_WEBHOOK_URL=
ALERT_CONFIDENCE=0.8

# Drain3
DRAIN3_DEPTH=3
DRAIN3_STUB_COUNT=20

# Kafka commit strategy
KAFKA_COMMIT_BATCH=100
KAFKA_COMMIT_INTERVAL_SEC=5

# Middlewares
MIDDLEWARE_HOST_ALLOWLIST=
MIDDLEWARE_MESSAGE_DENY_REGEX=
MIDDLEWARE_AUDIT_ENABLED=false
